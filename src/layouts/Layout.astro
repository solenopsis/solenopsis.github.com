---
const { title = 'Solenopsis', description = 'Salesforce developer tools and libraries.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Solenopsis</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/">Solenopsis</a>
        <nav aria-label="Primary navigation">
          <a href="/projects/">Projects</a>
          <a href="/about/">About</a>
          <a href="https://github.com/solenopsis">GitHub</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-wrap">
        <span>Solenopsis</span>
        <a href="https://github.com/solenopsis">github.com/solenopsis</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #17202a;
    background: #f7f8fa;
    font-synthesis: none;
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.6; }
  a { color: #1769aa; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .container { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.94); border-bottom: 1px solid #e5e7eb; backdrop-filter: blur(10px); }
  .nav-wrap { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { color: #111827; font-size: 1.2rem; font-weight: 800; letter-spacing: -.02em; }
  nav { display: flex; gap: 22px; font-size: .95rem; }
  nav a { color: #4b5563; }
  .site-footer { margin-top: 80px; border-top: 1px solid #e5e7eb; background: #fff; }
  .footer-wrap { min-height: 80px; display: flex; justify-content: space-between; align-items: center; color: #6b7280; font-size: .9rem; }
  .hero { padding: 110px 0 90px; background: linear-gradient(135deg, #101827 0%, #1d3557 55%, #276c86 100%); color: white; }
  .eyebrow { margin: 0 0 16px; color: #a8d8ea; font-size: .8rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 0; max-width: 820px; font-size: clamp(3rem, 8vw, 6.5rem); line-height: .95; letter-spacing: -.055em; }
  .hero p { max-width: 700px; margin: 28px 0 0; color: #dbeafe; font-size: clamp(1.1rem, 2vw, 1.35rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .button { display: inline-flex; padding: 11px 17px; border-radius: 8px; background: white; color: #14213d; font-weight: 700; }
  .button.secondary { background: rgba(255,255,255,.1); color: white; border: 1px solid rgba(255,255,255,.28); }
  .section { padding: 80px 0 0; }
  .section h2 { margin: 0 0 12px; font-size: 2rem; letter-spacing: -.03em; }
  .section-intro { max-width: 720px; color: #667085; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px; margin-top: 30px; }
  .card { display: flex; flex-direction: column; min-height: 220px; padding: 25px; background: white; border: 1px solid #e5e7eb; border-radius: 14px; box-shadow: 0 8px 30px rgba(15,23,42,.05); }
  .card h3 { margin: 0; font-size: 1.25rem; }
  .card p { color: #667085; }
  .card .link { margin-top: auto; font-weight: 700; }
  .prose { padding: 72px 0; max-width: 820px; }
  .prose h1 { font-size: clamp(2.5rem, 5vw, 4rem); color: #111827; }
  .prose h2 { margin-top: 42px; }
  .prose p, .prose li { color: #4b5563; }
  code { padding: 2px 5px; border-radius: 4px; background: #eef2f7; }
  @media (max-width: 640px) {
    .nav-wrap { align-items: flex-start; padding: 16px 0; flex-direction: column; }
    nav { gap: 14px; }
    .hero { padding: 75px 0 65px; }
    .footer-wrap { flex-direction: column; align-items: flex-start; justify-content: center; gap: 4px; }
  }
</style>
